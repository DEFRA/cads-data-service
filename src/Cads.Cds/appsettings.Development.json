{
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] ({Application}/{MachineName}/{ThreadId}/{SourceContext}.{Method}) {Message}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AuthenticationConfiguration": {
    "ApiKey": {
      "Enabled": true
    },
    "AwsSts": {
      "Enabled": false,
      "Audience": "https://cads-data-service.dev.cdp-int.defra.cloud",
      "TrustedOrgId": "o-kl1ac4xahf",
      "Environment": "dev",
      "RequireHttpsMetadata": false
    },
    "Cognito": {
      "Enabled": false,
      "Authority": null,
      "ScopeClaimType": "scope",
      "RoleClaimType": "role"
    },
    "AzureAD": {
      "Enabled": true,
      "Authority": "http://localhost:5557",
      "Audience": "api://local-cads-cds",
      "MetadataAddress": "http://localhost:5557/.well-known/openid-configuration",
      "RequireHttpsMetadata": false,
      "ValidateIssuer": false,
      "ScopeClaimType": "scope",
      "RoleClaimType": "role"
    }
  },
  "Acl": {
    "Clients": {
      "ApiKey": {
        "Type": "ApiKey",
        "Secret": "integration-test-secret",
        "Scopes": [ "access", "reports.read", "admin.db.execute", "admin.s3.manager", "admin.queue.manager" ]
      }
    },
    "StsClients": {
      "cads-bridge": { "Scopes": [ "access", "reports.read", "admin.db.execute", "admin.s3.manager", "admin.queue.manager" ] },
      "ls-keeper-data-api": { "Scopes": [ "access", "reports.read", "admin.db.execute", "admin.s3.manager", "admin.queue.manager" ] }
    }
  }
}
